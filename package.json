{
  "name": "hotkeys-trainer",
  "productName": "Hotkeys Trainer",
  "version": "1.0.0",
  "description": "Учебник, тренажёр и поиск сочетаний клавиш для macOS и Windows (Electron app with shortcut lessons, trainer and search for macOS and Windows)",
  "main": "main.js",
  "license": "MIT",
  "author": "aleksejyanover",
  "homepage": "https://github.com/aleksejyanover/hotkeys-trainer",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleksejyanover/hotkeys-trainer.git"
  },
  "keywords": [
    "hotkeys",
    "keyboard-shortcuts",
    "shortcuts",
    "trainer",
    "education",
    "electron",
    "macos",
    "windows",
    "learn"
  ],
  "scripts": {
    "start": "electron .",
    "test": "electron smoke-test.js",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hotkeys.trainer",
    "productName": "Hotkeys Trainer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
